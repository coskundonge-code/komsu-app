# KomşuApp - Ortam Değişkenleri
# Bu dosyayı .env.local olarak kopyalayın ve değerleri doldurun

# Supabase Yapılandırması
# Supabase proje ayarlarından alınır: https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Google Maps API (Harita özelliği için - isteğe bağlı)
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-key

# Google Cloud Vision — AI görsel moderasyonu (isteğe bağlı ama şiddetle önerilir)
# Anahtar girilene kadar /api/moderate-media "moderasyon kapalı" döner (yükleme
# bloklanmaz, fail-open); anahtar girilince yüklenen görseller müstehcen/şiddet
# için otomatik taranır. Google Cloud Console > Vision API'yi etkinleştir > API key.
# GOOGLE_CLOUD_VISION_API_KEY=your-google-cloud-vision-key

# E-posta Servisi (Resend veya SendGrid - isteğe bağlı)
# RESEND_API_KEY=your-resend-api-key

# Firebase Cloud Messaging (Push bildirim - isteğe bağlı)
# NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id

# Sentry hata izleme (isteğe bağlı — DSN olmadığında Sentry NO-OP olur)
# NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@sentry.io/yyyy
# SENTRY_DSN=https://xxxxx@sentry.io/yyyy

# PayTR ödeme (K1 tamamlanınca aktive edilecek)
# PAYTR_MERCHANT_ID=
# PAYTR_MERCHANT_KEY=
# PAYTR_MERCHANT_SALT=
# PAYTR_TEST_MODE=true
# SUPABASE_SERVICE_ROLE_KEY=
# NEXT_PUBLIC_BASE_URL=https://komsu-app.vercel.app

# Upstash rate limiting (isteğe bağlı)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
